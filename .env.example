# =====================================================================
# Izmir Smart Corridor - environment configuration template
# Copy to `.env` and fill in locally. `.env` is gitignored.
# NEVER put real secrets in this file; it is committed.
# Load into a shell with:  set -a; source .env; set +a
# =====================================================================

# ---------- SUMO (simulation/, ai/) ----------
# With the pip `eclipse-sumo` package this is
#   <venv>/lib/python<X.Y>/site-packages/sumo
# Get it with: python -c 'import sumo; print(sumo.SUMO_HOME)'
SUMO_HOME=
# `sumo` (headless) or `sumo-gui`
SUMO_BINARY=sumo

# ---------- MQTT broker (backend/; DRAFT, see shared/contracts/mqtt_topics.md) ----------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_PREFIX=izmir/corridor/v1

# ---------- Edge prototype (edge/prototypes/izum_live_detection.py) ----------
# Check IZUM's terms of use before using any camera stream.
IZUM_STREAM_URL=
# Optional extra request headers; leave empty (no browser impersonation).
IZUM_STREAM_USER_AGENT=
IZUM_STREAM_REFERER=
# Keep TLS verification on unless you have a documented reason.
IZUM_STREAM_VERIFY_TLS=true
# Path to YOLO weights (never committed). Ultralytics is AGPL-3.0, optional.
EDGE_YOLO_WEIGHTS=yolov8n.pt

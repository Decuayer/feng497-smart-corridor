# =====================================================================
# Izmir Smart Corridor - repository-wide ignore rules
# Policy: never commit secrets, raw data, model weights or simulation
# outputs. See CONTRIBUTING.md.
# =====================================================================

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.eggs/
.venv/
venv/
env/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ipynb_checkpoints/

# ---------- Node / dashboard ----------
node_modules/
.next/
out/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------- ML artefacts ----------
runs/
checkpoints/
wandb/
mlruns/
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.trt
*.tflite
*.safetensors

# ---------- SUMO outputs ----------
*.out.xml
tripinfo*.xml
edgeData*.xml
summary*.xml
fcd*.xml
emission*.xml
stats.xml
*.sumocfg.bak
*.netccfg.bak

# ---------- Data (see data/README.md) ----------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.xlsx
*.xls
*.csv
*.parquet
*.osm
*.osm.xml
*.osm.xml.gz
*.osm.pbf

# ---------- Large media (images allowed only under docs/) ----------
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.h264
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# ---------- OS / IDE ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------- Local-only (not part of the repo) ----------
# Personal prompts / scratch notes for AI coding assistants
/prompts/
# Archived, superseded or local-only artefacts
/_local/
# Legacy prototype locations (pre-restructure); safe to keep ignored
/2026-10-21-10-50-58/
/networks/osm.net.xml
/2026-10-21-14-55-12/osm.net.xml
/2026-10-21-14-55-12/osm.net.xml.gz
/2026-10-21-14-55-12/osm.passenger.trips.xml
